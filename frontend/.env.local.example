# ============================================================
# WODOGA FRONTEND — ENVIRONMENT VARIABLES
# Copy to .env.local and fill in values.
# NEVER commit .env.local to version control.
# ============================================================

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# App URL (used for redirects and portal links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App name shown in the browser tab
NEXT_PUBLIC_APP_NAME="Wodoga Platform"

# Feature flags
NEXT_PUBLIC_ENABLE_PORTAL=true
NEXT_PUBLIC_ENABLE_OASIS=true
