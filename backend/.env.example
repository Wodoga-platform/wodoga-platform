# ============================================================
# WODOGA PLATFORM — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ============================================================

# ── APPLICATION ──────────────────────────────────────────────
APP_NAME="Wodoga Platform"
APP_VERSION="2.0.0"
APP_ENV="development"           # development | staging | production
DEBUG=false
SECRET_KEY="CHANGE_THIS_TO_A_64_CHARACTER_RANDOM_STRING"
ALLOWED_ORIGINS="http://localhost:3000,https://app.wodoga.com"

# ── DATABASE ─────────────────────────────────────────────────
# Azure PostgreSQL Flexible Server connection string
DATABASE_URL="postgresql+asyncpg://wodoga_app:PASSWORD@HOST:5432/wodoga?ssl=require"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── AUTHENTICATION ───────────────────────────────────────────
JWT_SECRET_KEY="CHANGE_THIS_TO_A_64_CHARACTER_RANDOM_STRING"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER="Wodoga Platform"

# ── ENCRYPTION ───────────────────────────────────────────────
# Used to encrypt MFA secrets and sensitive fields at app layer
ENCRYPTION_KEY="CHANGE_THIS_TO_A_32_BYTE_BASE64_KEY"

# ── AZURE BLOB STORAGE ───────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME="wodogastorage"
AZURE_STORAGE_ACCOUNT_KEY="YOUR_AZURE_STORAGE_KEY_HERE"
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=..."
AZURE_STORAGE_CONTAINER_DOCUMENTS="documents"
AZURE_STORAGE_CONTAINER_SIGNATURES="signatures"
AZURE_STORAGE_SAS_TOKEN_EXPIRY_HOURS=2

# ── INSURANCE ELIGIBILITY API ────────────────────────────────
# Set ELIGIBILITY_PROVIDER to 'waystar', 'availity', or 'simulated'
ELIGIBILITY_PROVIDER="simulated"
WAYSTAR_API_URL="https://api.waystar.com/eligibility/v1"
WAYSTAR_API_KEY="YOUR_WAYSTAR_API_KEY"
WAYSTAR_SUBMITTER_ID="YOUR_SUBMITTER_ID"
AVAILITY_API_URL="https://api.availity.com/availity/v1"
AVAILITY_CLIENT_ID="YOUR_AVAILITY_CLIENT_ID"
AVAILITY_CLIENT_SECRET="YOUR_AVAILITY_CLIENT_SECRET"

# ── EMAIL ────────────────────────────────────────────────────
# SendGrid for transactional email
SENDGRID_API_KEY="YOUR_SENDGRID_API_KEY"
EMAIL_FROM="noreply@wodoga.com"
EMAIL_FROM_NAME="Wodoga Platform"

# ── SMS / MFA ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="YOUR_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"
TWILIO_FROM_NUMBER="+15551234567"

# ── REDIS (for rate limiting and session store) ───────────────
REDIS_URL="redis://localhost:6379/0"

# ── RATE LIMITING ────────────────────────────────────────────
RATE_LIMIT_DEFAULT="100/minute"
RATE_LIMIT_AUTH="10/minute"
RATE_LIMIT_ELIGIBILITY="30/minute"

# ── LOGGING ──────────────────────────────────────────────────
LOG_LEVEL="INFO"
LOG_FORMAT="json"               # json | text

# ── SECURITY ─────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
PASSWORD_MIN_LENGTH=10
SESSION_TIMEOUT_MINUTES=30
