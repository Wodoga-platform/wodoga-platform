"""
Wodoga Platform — Clinical Data Operation Tests
=================================================

WHAT THESE PROVE (plain English):
These test the core clinical data operations at the database level — the
create/read/update/soft-delete flows that clinicians use every day — and
confirm they behave correctly AND stay tenant-isolated.

Unlike test_tenant_isolation.py (which focuses purely on leakage) and
test_access_control.py (which checks role permissions), these focus on
"do the actual data operations work correctly?"

They cover:
  - Creating a patient and reading it back within the same org
  - Updating a patient's fields
  - Soft-deleting a patient (deleted_at set, disappears from normal reads)
  - Soft-delete attribution (deleted_by captures who)
  - Vitals and visits insert + scope correctly to their org
  - A soft-deleted patient does not appear in a standard "alive" query

These need a test database (see RUNNING_TESTS.md). Run:
    pytest tests/test_clinical_operations.py -v
"""
import uuid
import pytest
from sqlalchemy import text
from sqlalchemy.ext.asyncio import async_sessionmaker, AsyncSession

from tests.conftest import tenant_session


# ────────────────────────────────────────────────────────────
# Patient CRUD
# ────────────────────────────────────────────────────────────

@pytest.mark.asyncio
async def test_create_and_read_patient(engine, two_orgs):
    """A patient inserted in org A's context is readable in org A's context."""
    s = await tenant_session(engine, two_orgs["org_a"])
    try:
        pid = str(uuid.uuid4())
        await s.execute(
            text("""
                INSERT INTO patients (id, organization_id, first_name, last_name, date_of_birth)
                VALUES (:id, :org, 'Created', 'Test', '1960-05-05')
            """),
            {"id": pid, "org": two_orgs["org_a"]},
        )
        await s.commit()

        row = (await s.execute(
            text("SELECT first_name, last_name FROM patients WHERE id = :id"),
            {"id": pid},
        )).first()
        assert row is not None, "Created patient could not be read back"
        assert row[0] == "Created" and row[1] == "Test"

        # cleanup
        await s.execute(text("DELETE FROM patients WHERE id = :id"), {"id": pid})
        await s.commit()
    finally:
        await s.close()


@pytest.mark.asyncio
async def test_update_patient_fields(engine, two_orgs):
    """Updating a patient's field persists and reads back correctly."""
    s = await tenant_session(engine, two_orgs["org_a"])
    try:
        pid = str(uuid.uuid4())
        await s.execute(
            text("""
                INSERT INTO patients (id, organization_id, first_name, last_name, date_of_birth)
                VALUES (:id, :org, 'Before', 'Update', '1960-05-05')
            """),
            {"id": pid, "org": two_orgs["org_a"]},
        )
        await s.commit()

        await s.execute(
            text("UPDATE patients SET first_name = 'After' WHERE id = :id"),
            {"id": pid},
        )
        await s.commit()

        row = (await s.execute(
            text("SELECT first_name FROM patients WHERE id = :id"),
            {"id": pid},
        )).first()
        assert row[0] == "After", "Patient update did not persist"

        await s.execute(text("DELETE FROM patients WHERE id = :id"), {"id": pid})
        await s.commit()
    finally:
        await s.close()


