@pytest.mark.asyncio
async def test_vitals_insert_and_read(engine, two_orgs):
    """Vitals can be recorded for a patient and read back in-org."""
    s = await tenant_session(engine, two_orgs["org_a"])
    try:
        # two_orgs already made patient_a in org A
        vid = str(uuid.uuid4())
        await s.execute(
            text("""
                INSERT INTO vitals (id, organization_id, patient_id, heart_rate, recorded_at)
                VALUES (:id, :org, :pid, 72, NOW())
            """),
            {"id": vid, "org": two_orgs["org_a"], "pid": two_orgs["patient_a"]},
        )
        await s.commit()

        row = (await s.execute(
            text("SELECT heart_rate FROM vitals WHERE id = :id"),
            {"id": vid},
        )).first()
        assert row is not None and row[0] == 72

        await s.execute(text("DELETE FROM vitals WHERE id = :id"), {"id": vid})
        await s.commit()
    finally:
        await s.close()


@pytest.mark.asyncio
async def test_vitals_do_not_leak_across_orgs(engine, two_orgs):
    """Vitals recorded in org A must not be visible from org B."""
    # Insert a vital in org A
    sa = await tenant_session(engine, two_orgs["org_a"])
    vid = str(uuid.uuid4())
    try:
        await sa.execute(
            text("""
                INSERT INTO vitals (id, organization_id, patient_id, heart_rate, recorded_at)
                VALUES (:id, :org, :pid, 88, NOW())
            """),
            {"id": vid, "org": two_orgs["org_a"], "pid": two_orgs["patient_a"]},
        )
        await sa.commit()
    finally:
        await sa.close()

    # Try to read it from org B
    sb = await tenant_session(engine, two_orgs["org_b"])
    try:
        row = (await sb.execute(
            text("SELECT id FROM vitals WHERE id = :id"),
            {"id": vid},
        )).first()
        assert row is None, "LEAK: org B can see org A's vitals record!"
    finally:
        await sb.close()

    # cleanup from org A
    sa2 = await tenant_session(engine, two_orgs["org_a"])
    try:
        await sa2.execute(text("DELETE FROM vitals WHERE id = :id"), {"id": vid})
        await sa2.commit()
    finally:
        await sa2.close()


@pytest.mark.asyncio
async def test_visit_insert_and_cancel_attribution(engine, two_orgs):
    """A visit can be created and cancelled with cancelled_by attribution."""
    s = await tenant_session(engine, two_orgs["org_a"])
    try:
        vid = str(uuid.uuid4())
        actor = str(uuid.uuid4())
        await s.execute(
            text("""
                INSERT INTO visits (id, organization_id, patient_id, status, visit_date)
                VALUES (:id, :org, :pid, 'scheduled', CURRENT_DATE)
            """),
            {"id": vid, "org": two_orgs["org_a"], "pid": two_orgs["patient_a"]},
        )
        await s.commit()

        # Cancel with attribution (mirrors the endpoint)
        await s.execute(
            text("""
                UPDATE visits SET status = 'cancelled',
                    cancellation_reason = 'test', cancelled_by = :uid
                WHERE id = :id
            """),
            {"id": vid, "uid": actor},
        )
        await s.commit()

        row = (await s.execute(
            text("SELECT status, cancelled_by FROM visits WHERE id = :id"),
            {"id": vid},
        )).first()
        assert row[0] == "cancelled"
        assert str(row[1]) == actor, "cancelled_by did not capture the actor"

        await s.execute(text("DELETE FROM visits WHERE id = :id"), {"id": vid})
        await s.commit()
    finally:
        await s.close()
