@pytest.mark.asyncio
async def test_soft_delete_sets_deleted_at_and_by(engine, two_orgs):
    """Soft-deleting a patient sets deleted_at and deleted_by."""
    s = await tenant_session(engine, two_orgs["org_a"])
    try:
        pid = str(uuid.uuid4())
        actor = str(uuid.uuid4())  # a stand-in user id
        await s.execute(
            text("""
                INSERT INTO patients (id, organization_id, first_name, last_name, date_of_birth)
                VALUES (:id, :org, 'Soft', 'Delete', '1960-05-05')
            """),
            {"id": pid, "org": two_orgs["org_a"]},
        )
        await s.commit()

        # Soft-delete with attribution (mirrors the endpoint)
        await s.execute(
            text("UPDATE patients SET deleted_at = NOW(), deleted_by = :uid WHERE id = :id"),
            {"id": pid, "uid": actor},
        )
        await s.commit()

        row = (await s.execute(
            text("SELECT deleted_at, deleted_by FROM patients WHERE id = :id"),
            {"id": pid},
        )).first()
        assert row[0] is not None, "deleted_at was not set"
        assert str(row[1]) == actor, "deleted_by did not capture the actor"

        await s.execute(text("DELETE FROM patients WHERE id = :id"), {"id": pid})
        await s.commit()
    finally:
        await s.close()


@pytest.mark.asyncio
async def test_soft_deleted_patient_excluded_from_alive_query(engine, two_orgs):
    """A soft-deleted patient should not appear in a WHERE deleted_at IS NULL query."""
    s = await tenant_session(engine, two_orgs["org_a"])
    try:
        pid = str(uuid.uuid4())
        await s.execute(
            text("""
                INSERT INTO patients (id, organization_id, first_name, last_name, date_of_birth, deleted_at)
                VALUES (:id, :org, 'Ghost', 'Patient', '1960-05-05', NOW())
            """),
            {"id": pid, "org": two_orgs["org_a"]},
        )
        await s.commit()

        # The standard "alive patients" query the app uses
        rows = (await s.execute(
            text("SELECT id FROM patients WHERE deleted_at IS NULL AND id = :id"),
            {"id": pid},
        )).all()
        assert len(rows) == 0, "Soft-deleted patient appeared in an alive-only query"

        await s.execute(text("DELETE FROM patients WHERE id = :id"), {"id": pid})
        await s.commit()
    finally:
        await s.close()


