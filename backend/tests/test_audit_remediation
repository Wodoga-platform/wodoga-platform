from __future__ import annotations

import pytest


# ────────────────────────────────────────────────────────────
# Rate-limit key extraction (X-Forwarded-For handling)
# ────────────────────────────────────────────────────────────
#
# Why this matters: behind Railway's proxy, request.client.host is
# Railway's internal proxy IP, not the real client. If we didn't read
# X-Forwarded-For, every request would share one rate-limit bucket and
# the limiter would be useless (the exact bug we hit in production).
# These tests prove the key function reads the right header in every
# scenario.

class _FakeRequest:
    """Minimal stand-in for a starlette Request — has headers and a
    client object, which is all _client_ip looks at."""
    def __init__(self, headers: dict, client_host: str | None = "127.0.0.1"):
        self.headers = headers
        self.client = type("c", (), {"host": client_host})() if client_host else None


def test_client_ip_reads_first_xff_when_header_present():
    from app.core.limiter import _client_ip
    req = _FakeRequest(headers={"x-forwarded-for": "203.0.113.42, 10.0.0.1, 10.0.0.2"})
    assert _client_ip(req) == "203.0.113.42"


def test_client_ip_strips_whitespace_in_xff():
    from app.core.limiter import _client_ip
    req = _FakeRequest(headers={"x-forwarded-for": "   198.51.100.5   ,10.0.0.1"})
    assert _client_ip(req) == "198.51.100.5"


def test_client_ip_falls_back_when_no_xff_header():
    """No proxy in front (local dev) — fall back to direct client address."""
    from app.core.limiter import _client_ip
    req = _FakeRequest(headers={}, client_host="192.0.2.99")
    # get_remote_address may return the host string or a normalized form;
    # any non-empty string is acceptable. The key requirement: it does
    # NOT raise, and it produces something useful for bucketing.
    result = _client_ip(req)
    assert result and isinstance(result, str)


def test_client_ip_single_address_in_xff():
    """Common case: single hop, single IP in the header."""
    from app.core.limiter import _client_ip
    req = _FakeRequest(headers={"x-forwarded-for": "203.0.113.99"})
    assert _client_ip(req) == "203.0.113.99"


# ────────────────────────────────────────────────────────────
# Biller field filtering (Critical #1 from PERMISSION_AUDIT_V2)
# ────────────────────────────────────────────────────────────
#
# Why this matters: a biller doesn't need clinical free-text fields
# (allergies, medical history, notes) to do billing. The patient endpoint
# strips these fields when the caller is a biller. If a future change
# silently removed the strip, billers would silently regain clinical
# access — a HIPAA minimum-necessary violation. These tests pin the
# behavior so that silent regression becomes a failing test.
#
# The logic itself is small enough that we replicate the strip locally
# rather than importing the endpoint (which has DB dependencies). If
# the endpoint logic ever diverges from the constant list here, the
# test will fail and remind us to keep them in sync.

CLINICAL_FIELDS_BILLER_SHOULD_NOT_SEE = (
    "allergies",
    "medical_history",
    "secondary_diagnoses",
    "notes",
    "photo_url",
    "fall_risk",
    "blood_type",
)

BILLER_RELEVANT_FIELDS = (
    "id",
    "first_name",
    "last_name",
    "date_of_birth",
    "primary_diagnosis",  # billers need ICD codes
    "insurance_provider",
    "insurance_id",
    "address_line1",
    "city",
    "state",
)


def _strip_for_biller(patient_data: dict) -> dict:
    """Mirrors the strip done in patients.py:get_patient."""
    out = dict(patient_data)
    for f in CLINICAL_FIELDS_BILLER_SHOULD_NOT_SEE:
        out.pop(f, None)
    return out


def _sample_patient_record() -> dict:
    """A realistic patient row as the endpoint returns it."""
    return {
        "id": "abc-123",
        "first_name": "Test",
        "last_name": "Patient",
        "date_of_birth": "1950-01-01",
        "primary_diagnosis": "I50.9",  # billing-relevant
        "secondary_diagnoses": ["E11.9", "I10"],  # clinical
        "allergies": "Penicillin, latex",  # clinical
        "medical_history": "CHF since 2019",  # clinical
        "notes": "Patient prefers morning visits",  # clinical
        "fall_risk": "high",  # clinical
        "blood_type": "O+",  # clinical
        "photo_url": "https://example.com/p.jpg",  # clinical/identifier
        "insurance_provider": "Medicare",
        "insurance_id": "1AB-2CD-3EF",
        "address_line1": "123 Test St",
        "city": "Arlington",
        "state": "TX",
    }


def test_biller_filter_strips_clinical_free_text():
    """The clinical fields a biller shouldn't see must be absent."""
    filtered = _strip_for_biller(_sample_patient_record())
    for field in CLINICAL_FIELDS_BILLER_SHOULD_NOT_SEE:
        assert field not in filtered, f"{field} should be stripped for biller"


def test_biller_filter_preserves_billing_relevant_fields():
    """Billers MUST still see identifiers, insurance, primary diagnosis."""
    filtered = _strip_for_biller(_sample_patient_record())
    for field in BILLER_RELEVANT_FIELDS:
        assert field in filtered, f"{field} should be present for biller"


def test_biller_filter_is_idempotent():
    """Re-stripping an already-stripped record is a no-op (no errors)."""
    once = _strip_for_biller(_sample_patient_record())
    twice = _strip_for_biller(once)
    assert once == twice


def test_biller_filter_handles_missing_fields_gracefully():
    """If a patient record happens to lack some clinical fields, the
    strip should still succeed without KeyError."""
    minimal = {"id": "x", "first_name": "A", "last_name": "B"}
    result = _strip_for_biller(minimal)
    assert result == minimal


# ────────────────────────────────────────────────────────────
# Alembic env URL rewriting
# ────────────────────────────────────────────────────────────
#
# Why this matters: the app uses asyncpg, but Alembic runs migrations
# synchronously. env.py rewrites the URL so migrations can use psycopg2.
# A regression here would mean migrations fail to run, which is the
# kind of thing that's quietly broken until you need it most. These
# don't run the full env.py (that would require Alembic's context); they
# pin the rewriting logic so it doesn't drift.

def _rewrite_db_url(url: str) -> str:
    """Mirrors the rewriting in alembic/env.py:_resolve_database_url."""
    if "+asyncpg" in url:
        url = url.replace("+asyncpg", "+psycopg2")
    elif url.startswith("postgresql://") or url.startswith("postgres://"):
        url = url.replace("postgres://", "postgresql://", 1) if url.startswith("postgres://") else url
        url = url.replace("postgresql://", "postgresql+psycopg2://", 1)
    return url


def test_url_rewrite_asyncpg_to_psycopg2():
    assert _rewrite_db_url("postgresql+asyncpg://u:p@h:5432/db") == "postgresql+psycopg2://u:p@h:5432/db"


def test_url_rewrite_plain_postgresql_adds_psycopg2():
    assert _rewrite_db_url("postgresql://u:p@h:5432/db") == "postgresql+psycopg2://u:p@h:5432/db"


def test_url_rewrite_railway_style_postgres_scheme():
    """Railway sometimes uses postgres:// (no 'ql'). Should normalize and add driver."""
    assert _rewrite_db_url("postgres://u:p@h:5432/db") == "postgresql+psycopg2://u:p@h:5432/db"


def test_url_rewrite_psycopg2_url_unchanged():
    """Already psycopg2 — don't double-rewrite."""
    url = "postgresql+psycopg2://u:p@h:5432/db"
    assert _rewrite_db_url(url) == url


# ────────────────────────────────────────────────────────────
# Bcrypt round-trip (test caregiver password setup we used)
# ────────────────────────────────────────────────────────────
#
# Why this matters: we set a caregiver test password via direct bcrypt
# hash insertion. Confirms the cost factor we use works and the hash
# format matches what the app expects.

def test_bcrypt_hash_and_verify_roundtrip():
    import bcrypt
    password = b"TestPassword2026!"
    h = bcrypt.hashpw(password, bcrypt.gensalt(rounds=12))
    assert bcrypt.checkpw(password, h)


def test_bcrypt_rejects_wrong_password():
    import bcrypt
    h = bcrypt.hashpw(b"CorrectHorse123!", bcrypt.gensalt(rounds=12))
    assert not bcrypt.checkpw(b"WrongHorse123!", h)


def test_bcrypt_hashes_are_unique_per_call():
    """Same password → different hashes (salt differs each time). Important
    so that hash comparison can't reveal whether two users share a password."""
    import bcrypt
    password = b"SamePassword2026!"
    h1 = bcrypt.hashpw(password, bcrypt.gensalt(rounds=12))
    h2 = bcrypt.hashpw(password, bcrypt.gensalt(rounds=12))
    assert h1 != h2
    # Both still verify
    assert bcrypt.checkpw(password, h1)
    assert bcrypt.checkpw(password, h2)
